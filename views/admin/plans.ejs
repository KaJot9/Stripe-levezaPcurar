<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title>Planos — Painel Admin</title>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/nav') %>

  <main class="admin-container">
    <div class="admin-header-row">
      <h1>Planos</h1>
      <button id="btn-novo-plano" class="btn primario">+ Novo plano</button>
    </div>

    <table class="admin-table">
      <thead>
        <tr>
          <th>Ordem</th>
          <th>Nome</th>
          <th>Price ID</th>
          <th>Valor</th>
          <th>Link do grupo</th>
          <th>Status</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody id="tabela-planos">
        <tr><td colspan="7">Carregando...</td></tr>
      </tbody>
    </table>
  </main>

  <div id="plano-modal" class="modal hidden">
    <div class="modal-box">
      <h2 id="plano-modal-titulo">Novo plano</h2>
      <form id="form-plano">
        <input type="hidden" id="plano-id" />

        <label>Nome</label>
        <input type="text" id="plano-nome" required />

        <label>Price ID (Stripe)</label>
        <input type="text" id="plano-price-id" placeholder="price_xxx" required />

        <label>Valor (R$)</label>
        <input type="number" id="plano-valor" step="0.01" min="0" required />

        <label>Link do grupo</label>
        <input type="url" id="plano-link" placeholder="https://..." required />

        <label>Ordem de exibição</label>
        <input type="number" id="plano-ordem" value="0" />

        <label class="checkbox-label">
          <input type="checkbox" id="plano-ativo" checked />
          Plano ativo
        </label>

        <p id="plano-erro" class="erro hidden"></p>

        <div class="modal-actions">
          <button type="button" id="btn-fechar-modal" class="btn secundario">Cancelar</button>
          <button type="submit" class="btn primario">Salvar</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/admin/plans.js"></script>
</body>
</html>
